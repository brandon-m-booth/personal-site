---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // `external: true` projects have no page of their own - they're a tile on /projects that
  // links straight out to their first `links` entry (see src/content/config.ts).
  const projects = await getCollection(
    'projects',
    ({ data }) => (!data.draft || import.meta.env.DEV) && !data.external
  );
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="container">
    <p><a href="/projects">&larr; All projects</a></p>
    <h1 style="margin-bottom:0.2rem;">{project.data.title}</h1>
    <p class="muted" style="margin-top:0;">
      {[project.data.organization, project.data.dates].filter(Boolean).join(' · ')}
      {project.data.draft && <strong style="color:#b5442e;"> &middot; DRAFT</strong>}
    </p>

    {project.data.image && (
      <img
        src={project.data.image}
        alt={project.data.imageAlt || ''}
        style={`display:block; width:${project.data.imageWidth}%; border-radius:10px; margin:1rem auto;`}
      />
    )}

    {project.data.links.length > 0 && (
      <p style="display:flex; gap:0.6rem; flex-wrap:wrap;">
        {project.data.links.map((link: { label: string; url: string }) => (
          <a class="btn-outline btn-external" href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="external-icon" aria-hidden="true">&#8599;</span>
            <span class="sr-only"> (external link, opens in a new tab)</span>
          </a>
        ))}
      </p>
    )}

    <div>
      {project.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>

    <div class="prose" style="margin-top:1.5rem;">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose :global(h2) {
    margin-top: 2rem;
  }
  /* External link buttons (the "links" frontmatter list above the tags) get a visible fill,
     a slight lift shadow, and a small "leaves the site" arrow icon so they read as clickable
     buttons that go somewhere else, not plain text. */
  .btn-external {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-card-bg);
    box-shadow: 0 1px 3px rgba(31, 61, 99, 0.16);
  }
  .btn-external:hover {
    box-shadow: 0 2px 5px rgba(31, 61, 99, 0.22);
  }
  .btn-external .external-icon {
    font-size: 0.85em;
    color: var(--color-text-muted);
  }
  .btn-external:hover .external-icon {
    color: var(--color-accent);
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }
  /* A responsive grid of captioned photos - used for old-site project galleries
     migrated as <div class="project-gallery"><figure>...</figure>...</div>. */
  .prose :global(.project-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin: 1.25rem 0;
  }
  .prose :global(.project-gallery figure) {
    margin: 0;
  }
  .prose :global(.project-gallery img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  .prose :global(.project-gallery figcaption) {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 0.4rem;
    line-height: 1.4;
  }
  /* A responsive 16:9 embedded video (e.g. a YouTube iframe). */
  .prose :global(.video-embed) {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    margin: 1.25rem 0;
  }
  .prose :global(.video-embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    border: none;
  }

  /* A one-at-a-time photo carousel - used for old-site project galleries
     migrated as <div class="project-carousel"><div class="project-carousel-viewport">
     <div class="project-carousel-slide"><img/></div>...</div>
     <button class="project-carousel-arrow project-carousel-prev">...</button>
     <button class="project-carousel-arrow project-carousel-next">...</button>
     <div class="project-carousel-dots"></div></div>. Dots and slide-switching are
     wired up by the <script> below; the markup works (first slide visible, no
     dots) even if JavaScript never runs. */
  .prose :global(.project-carousel) {
    margin: 1.25rem 0;
    outline: none;
  }
  .prose :global(.project-carousel-viewport) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }
  .prose :global(.project-carousel-slide) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .prose :global(.project-carousel-slide.is-active) {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }
  .prose :global(.project-carousel-slide img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    border-radius: 0;
    display: block;
  }
  /* Optional per-slide caption: put a <p class="project-carousel-caption"> right after the
     <img> inside a .project-carousel-slide. Since only the active slide is opacity:1, the
     caption automatically follows its own slide with no extra JS - it's just an overlay bar
     anchored to the bottom of that slide's box. */
  .prose :global(.project-carousel-caption) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: rgba(31, 61, 99, 0.82);
    color: #fdfbf6;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.4;
    text-align: left;
  }
  .prose :global(.project-carousel-arrow) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: rgba(253, 251, 246, 0.9);
    color: var(--color-secondary);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .prose :global(.project-carousel-arrow:hover) {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }
  .prose :global(.project-carousel-prev) {
    left: 0.6rem;
  }
  .prose :global(.project-carousel-next) {
    right: 0.6rem;
  }
  .prose :global(.project-carousel-dots) {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .prose :global(.project-carousel-dot) {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    padding: 0;
    cursor: pointer;
  }
  .prose :global(.project-carousel-dot.is-active) {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .prose :global(.project-carousel-counter) {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.35rem;
  }
</style>

<script>
  function initProjectCarousels() {
    document.querySelectorAll<HTMLElement>('.project-carousel').forEach((carousel) => {
      if (carousel.dataset.carouselInit === 'true') return;

      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.project-carousel-slide'));
      if (slides.length === 0) return;
      carousel.dataset.carouselInit = 'true';

      // Single-image "carousels" don't need arrows/dots/keyboard handling.
      if (slides.length === 1) {
        slides[0].classList.add('is-active');
        return;
      }

      let current = Math.max(0, slides.findIndex((s) => s.classList.contains('is-active')));

      const dotsContainer = carousel.querySelector('.project-carousel-dots');
      const dots = slides.map((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'project-carousel-dot';
        dot.setAttribute('aria-label', `Go to image ${i + 1} of ${slides.length}`);
        dot.addEventListener('click', () => goTo(i));
        dotsContainer?.appendChild(dot);
        return dot;
      });

      const counter = carousel.querySelector('.project-carousel-counter');

      function render() {
        slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
        if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
      }

      function goTo(i: number) {
        current = (i + slides.length) % slides.length;
        render();
      }

      carousel.querySelector('.project-carousel-prev')?.addEventListener('click', () => goTo(current - 1));
      carousel.querySelector('.project-carousel-next')?.addEventListener('click', () => goTo(current + 1));

      carousel.setAttribute('tabindex', '0');
      carousel.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') goTo(current - 1);
        if (e.key === 'ArrowRight') goTo(current + 1);
      });

      render();
    });
  }

  initProjectCarousels();
  document.addEventListener('astro:page-load', initProjectCarousels);
</script>
