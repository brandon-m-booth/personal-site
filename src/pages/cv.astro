---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Curriculum Vitae" description="Curriculum vitae">
  <div class="container">
    <div class="section-heading">
      <h1>Curriculum Vitae</h1>
      <a class="btn" href="/cv.pdf" download>Download PDF</a>
    </div>
    <object data="/cv.pdf" type="application/pdf" class="cv-embed">
      <p>
        Your browser can't display the PDF inline. <a href="/cv.pdf">Download it here</a>{' '}
        instead.
      </p>
    </object>
  </div>
</BaseLayout>
