---
import BaseLayout from '../../layouts/BaseLayout.astro';
import publications from '../../data/publications.generated.json';
import { EXTERNAL_LINKS } from '../../site.config';
import PageQuote from '../../components/PageQuote.astro';

// The "Unpublished" section at the bottom is rendered statically (title,
// year, and a direct download link only) rather than through the
// search/format-toggle UI below - these aren't formal citations, so they're
// kept simple, matching how the original site presented them.
const unpublished = publications
  .filter((p) => p.category === 'unpublished')
  .sort((a, b) => (b.year || 0) - (a.year || 0));

const listedPubs = publications.filter((p) => p.category !== 'unpublished');

const CATEGORY_ORDER = ['journal', 'conference', 'book', 'preprint', 'other'];
const categories = [...new Set(listedPubs.map((p) => p.category))].sort(
  (a, b) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b)
);
---

<BaseLayout title="Publications" description="Publications by Brandon M. Booth.">
  <div class="container-wide">
    <div class="section-heading">
      <h1>Publications</h1>
      <span class="muted">{publications.length} entries</span>
    </div>

    <PageQuote quote="Publication is a marathon, not a sprint..." author="Jo Linsdell" />

    <form class="pub-controls" id="pub-controls">
      <input type="search" id="pub-search" placeholder="Search title, venue, author..." aria-label="Search publications" />
      <select id="pub-sort" aria-label="Sort publications">
        <option value="year-desc">Newest first</option>
        <option value="year-asc">Oldest first</option>
        <option value="title-asc">Title A-Z</option>
      </select>
    </form>

    <p id="pub-count" class="muted" style="font-size:0.85rem;"></p>

    <div id="pub-list"></div>

    <noscript>
      <div>
        {categories.map((cat) => (
          <>
            <h2 class="pub-section-heading">{listedPubs.find((p) => p.category === cat)?.categoryLabel}</h2>
            {listedPubs
              .filter((p) => p.category === cat)
              .map((pub) => (
                <div class="pub-entry">
                  <div class="pub-citation" set:html={pub.formats.apa} />
                  <div class="pub-meta">
                    {pub.note && <>{pub.note} &middot; </>}
                    {pub.officialUrl && <a href={pub.officialUrl} target="_blank" rel="noopener noreferrer">{pub.officialLabel}</a>}
                    {pub.officialUrl && pub.draftUrl && <> &middot; </>}
                    {pub.draftUrl && <a href={pub.draftUrl} target="_blank" rel="noopener noreferrer">Draft paper</a>}
                  </div>
                </div>
              ))}
          </>
        ))}
      </div>
    </noscript>

    {unpublished.length > 0 && (
      <section class="pub-unpublished">
        <h2 class="pub-section-heading">Unpublished</h2>
        <p class="muted" style="font-size:0.9rem; margin-top:-0.5rem;">
          Papers that were never formally published.
        </p>
        {unpublished.map((pub) => (
          <div class="pub-entry pub-entry-unpublished">
            <div class="pub-unpub-title">
              {pub.title}
              {pub.year && <span class="muted"> ({pub.year})</span>}
            </div>
            <div class="pub-meta">
              {pub.note && <>{pub.note} &middot; </>}
              {pub.url && <a href={pub.url} target="_blank" rel="noopener noreferrer">Download File</a>}
            </div>
          </div>
        ))}
      </section>
    )}
  </div>

  <script type="application/json" id="pub-data" set:html={JSON.stringify(listedPubs)} />

  <script>
    type Format = 'apa' | 'mla' | 'chicago' | 'bibtex';

    interface Pub {
      id: string;
      title: string;
      authors: string;
      year: number | null;
      venue: string;
      category: string;
      categoryLabel: string;
      note: string;
      officialUrl: string;
      officialLabel: string;
      draftUrl: string;
      formats: Record<Format, string>;
    }

    const CATEGORY_ORDER = ['journal', 'conference', 'book', 'preprint', 'other'];

    const dataEl = document.getElementById('pub-data');
    const pubs: Pub[] = JSON.parse(dataEl?.textContent || '[]');

    const listEl = document.getElementById('pub-list')!;
    const countEl = document.getElementById('pub-count')!;
    const searchEl = document.getElementById('pub-search') as HTMLInputElement;
    const sortEl = document.getElementById('pub-sort') as HTMLSelectElement;

    // Remember each entry's currently-selected citation format across re-renders.
    const activeFormat = new Map<string, Format>();

    function matchesSearch(pub: Pub, query: string) {
      if (!query) return true;
      const haystack = `${pub.title} ${pub.authors} ${pub.venue} ${pub.note}`.toLowerCase();
      return haystack.includes(query.toLowerCase());
    }

    function sortPubs(list: Pub[], mode: string) {
      const sorted = [...list];
      if (mode === 'year-asc') {
        sorted.sort((a, b) => (a.year || 0) - (b.year || 0) || a.title.localeCompare(b.title));
      } else if (mode === 'title-asc') {
        sorted.sort((a, b) => a.title.localeCompare(b.title));
      } else {
        sorted.sort((a, b) => (b.year || 0) - (a.year || 0) || a.title.localeCompare(b.title));
      }
      return sorted;
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function escapeAttr(str: string) {
      return str.replace(/"/g, '&quot;');
    }

    function renderEntry(pub: Pub) {
      const fmt = activeFormat.get(pub.id) || 'apa';
      const citationHtml =
        fmt === 'bibtex'
          ? `<pre class="pub-citation bibtex">${escapeHtml(pub.formats.bibtex)}</pre>`
          : `<div class="pub-citation">${pub.formats[fmt]}</div>`;

      const buttons: Format[] = ['apa', 'mla', 'chicago', 'bibtex'];
      const toggle = buttons
        .map(
          (f) =>
            `<button type="button" class="fmt-btn${f === fmt ? ' active' : ''}" data-id="${pub.id}" data-fmt="${f}">${f.toUpperCase()}</button>`
        )
        .join('');

      const metaParts: string[] = [];
      if (pub.note) metaParts.push(escapeHtml(pub.note));
      if (pub.officialUrl) {
        metaParts.push(
          `<a href="${escapeAttr(pub.officialUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(pub.officialLabel)}</a>`
        );
      }
      if (pub.draftUrl) {
        metaParts.push(
          `<a href="${escapeAttr(pub.draftUrl)}" target="_blank" rel="noopener noreferrer">Draft paper</a>`
        );
      }

      return `
        <div class="pub-entry" data-id="${pub.id}">
          ${citationHtml}
          <div class="pub-meta">${metaParts.join(' &middot; ')}</div>
          <div class="pub-format-toggle">
            ${toggle}
            <button type="button" class="copy-btn" data-copy-id="${pub.id}">Copy citation</button>
          </div>
        </div>
      `;
    }

    function render() {
      const query = searchEl.value.trim();
      const sortMode = sortEl.value;

      let filtered = pubs.filter((p) => matchesSearch(p, query));
      filtered = sortPubs(filtered, sortMode);

      countEl.textContent = `Showing ${filtered.length} of ${pubs.length}`;

      const sections = CATEGORY_ORDER.map((cat) => ({
        cat,
        label: pubs.find((p) => p.category === cat)?.categoryLabel || cat,
        items: filtered.filter((p) => p.category === cat),
      })).filter((s) => s.items.length > 0);

      listEl.innerHTML =
        sections
          .map((section) => `<h2 class="pub-section-heading">${escapeHtml(section.label)}</h2>${section.items.map(renderEntry).join('')}`)
          .join('') || '<p class="muted">No publications match your search.</p>';
    }

    listEl.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      if (target.matches('.fmt-btn')) {
        const id = target.getAttribute('data-id')!;
        const fmt = target.getAttribute('data-fmt') as Format;
        activeFormat.set(id, fmt);
        render();
      } else if (target.matches('.copy-btn')) {
        const id = target.getAttribute('data-copy-id')!;
        const pub = pubs.find((p) => p.id === id);
        if (!pub) return;
        const fmt = activeFormat.get(id) || 'apa';
        const text =
          fmt === 'bibtex' ? pub.formats.bibtex : (new DOMParser().parseFromString(pub.formats[fmt], 'text/html').body.textContent || '');
        try {
          await navigator.clipboard.writeText(text.trim());
          const original = target.textContent;
          target.textContent = 'Copied!';
          setTimeout(() => (target.textContent = original), 1200);
        } catch {
          // Clipboard API unavailable (e.g. insecure context) - silently ignore.
        }
      }
    });

    searchEl.addEventListener('input', render);
    sortEl.addEventListener('change', render);

    render();
  </script>
</BaseLayout>
