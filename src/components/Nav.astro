---
import { SITE, NAV_LINKS } from '../site.config';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container-wide">
    <a class="site-title" href="/">{SITE.name}</a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {
          NAV_LINKS.map((link) => {
            const linkPath = link.href.replace(/\/$/, '') || '/';
            const isCurrent =
              linkPath === '/' ? currentPath === '/' : currentPath.startsWith(linkPath);
            return (
              <li>
                <a href={link.href} aria-current={isCurrent ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
